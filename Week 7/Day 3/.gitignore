# Ignore everything in this folder by default.
*

# Keep directories traversable so Python files in subfolders can be tracked.
!*/

# Track Python source files and this rule file.
!*.py
!**/*.py
!.gitignore

# Track the voice frontend; its own rules exclude dependencies and secrets.
!voice-frontend-nextjs/
!voice-frontend-nextjs/voice-frontend/
!voice-frontend-nextjs/voice-frontend/**
